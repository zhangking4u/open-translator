{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenTranslator",
  "version": "0.1.0",
  "identifier": "dev.opentranslator.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenTranslator",
        "width": 520,
        "height": 240,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "shadow": false,
        "transparent": false
      },
      {
        "label": "input",
        "title": "输入翻译",
        "width": 520,
        "height": 360,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
