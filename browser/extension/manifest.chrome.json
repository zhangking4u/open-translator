{
  "manifest_version": 3,
  "name": "OpenTranslator",
  "version": "0.3.0",
  "description": "Translate the selected text with the local OpenTranslator service.",
  "permissions": [
    "contextMenus",
    "storage",
    "alarms",
    "clipboardRead"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OpenTranslator"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "js": [
        "languages.js",
        "dropdown.js",
        "content.js"
      ]
    }
  ],
  "commands": {
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "翻译选中文本（OpenTranslator）"
    },
    "translate-clipboard": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      },
      "description": "翻译剪贴板文本（OpenTranslator）"
    },
    "cycle-target": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "边写边译：切换目标语言（OpenTranslator）"
    }
  },
  "options_ui": {
    "page": "options.html"
  }
}
